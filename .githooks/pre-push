#!/usr/bin/env bash
#
# Pre-push gate. Armed by scripts/install-hooks.sh (git config core.hooksPath .githooks).
#
# This file is deliberately a thin shim. Every check lives in
# scripts/preflight.sh, which is also the single step of the reusable CI
# workflow. One file, two call sites - that is why a local pass and a CI pass
# cannot disagree. The only logic here is deciding whether there is anything
# to check at all.
#
# A PUSH THAT ONLY DELETES BRANCHES IS NOT PREFLIGHTED. git hands this hook one
# line per ref on stdin, `<local ref> <local sha> <remote ref> <remote sha>`,
# and for `git push origin --delete x` the local sha is forty zeros. Nothing
# leaves this machine, so there is nothing to judge - but until 2026-10-12 the
# gate judged the working tree's HEAD anyway, and `git push --delete` of a
# merged probe branch was refused for an SC2164 in a script on an unrelated,
# unpushed local branch. That is the header's first bug class exactly: the gate
# failing on something this push never touched.
#
# TO BYPASS IN A GENUINE EMERGENCY
#   CLAUDE_PUSH_UNVERIFIED=1 git push --no-verify
# The bare `git push --no-verify` is refused by
# .claude/hooks/deny-blind-staging.sh, which ships alongside this file - an
# emergency exit only this header knew about is not an exit. Nothing here reads
# the prefix; --no-verify means git never runs this file at all. It is read by
# that hook, before the push is typed, and its whole job is to put the bypass
# in the transcript instead of leaving it silent.
#
# Reaching for it says one of two things, and they are not the same bug:
#   * the gate failed on something this change never touched - the state of
#     your machine, or code that was already broken when you cloned it. The
#     gate is meant to judge your diff, so that is a bug in preflight.sh.
#     Report it; a habit of bypassing is how the gate stops existing.
#   * the gate failed on what you actually changed. Then it is working, and
#     the bypass ships a change you already know is broken to a branch that
#     auto-deploys. Sometimes that is the right call. It is on the record.
#
set -uo pipefail
ZERO_SHA=0000000000000000000000000000000000000000
SAW_REF=0; PUSHES_CONTENT=0
while read -r _ LOCAL_SHA _ _; do
  SAW_REF=1
  [ "$LOCAL_SHA" = "$ZERO_SHA" ] || PUSHES_CONTENT=1
done
# No ref lines at all means this was run by hand, not by git: judge the tree.
if [ "$SAW_REF" -eq 1 ] && [ "$PUSHES_CONTENT" -eq 0 ]; then
  echo "pre-push: delete-only push - nothing leaves this machine, nothing to preflight"
  exit 0
fi
ROOT="$(git rev-parse --show-toplevel)" || exit 0
[ -f "$ROOT/scripts/preflight.sh" ] || { echo "pre-push: scripts/preflight.sh absent - nothing to run"; exit 0; }
exec bash "$ROOT/scripts/preflight.sh"
